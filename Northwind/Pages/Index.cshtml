@page
@model IndexModel
@{
    ViewData["Title"] = "A little Northwind";
}

<section class="welcome-hero">
    <div class="welcome-copy">
        <span class="eyebrow"><span aria-hidden="true">✿</span> A little hello from Northwind</span>
        <h1>Good people.<br /><span>Good things.</span></h1>
        <p class="hero-description">
            Meet the lovely customers who make our little corner of the world feel connected.
            Pick a name, discover a place, and stay awhile.
        </p>
        <a class="button button-primary" asp-page="/Customers">
            Meet our customers <span aria-hidden="true">↗</span>
        </a>
        <div class="hero-footnote"><span aria-hidden="true">♡</span> Made with a little extra care</div>
    </div>

    <div class="welcome-photo-wrap">
        <img class="welcome-photo"
             src="https://images.pexels.com/photos/260922/pexels-photo-260922.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200"
             alt="A warm, welcoming restaurant ready for guests"
             fetchpriority="high" />
        <div class="photo-sticker" aria-label="Good things grow together">
            <span aria-hidden="true">✿</span>
            <span>good things<br />grow together</span>
        </div>
        <div class="photo-caption">A table with room for everyone</div>
    </div>
</section>

<section class="little-note" aria-labelledby="note-title">
    <div class="note-flower" aria-hidden="true">✿</div>
    <div>
        <span class="section-kicker">The Northwind feeling</span>
        <h2 id="note-title">A neighborhood, not just a list.</h2>
        <p>Every customer has a story, a hometown, and a place at our table. Here are a few little snapshots of the things that bring us together.</p>
    </div>
</section>

<section class="inspiration-grid" aria-label="A few things we love">
    <article class="inspiration-card">
        <img src="https://images.pexels.com/photos/3026808/pexels-photo-3026808.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900"
             alt="Colorful bowls of food ready to share" loading="lazy" />
        <div class="inspiration-label"><span>01</span><h3>Made to be shared</h3></div>
    </article>
    <article class="inspiration-card inspiration-card-tall">
        <img src="https://images.pexels.com/photos/376464/pexels-photo-376464.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900"
             alt="A stack of pancakes with berries" loading="lazy" />
        <div class="inspiration-label"><span>02</span><h3>Little everyday joys</h3></div>
    </article>
    <article class="inspiration-card">
        <img src="https://images.pexels.com/photos/3184436/pexels-photo-3184436.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900"
             alt="A group of people joining hands around a table" loading="lazy" />
        <div class="inspiration-label"><span>03</span><h3>Better together</h3></div>
    </article>
</section>
<p class="photo-credit">Photography via <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer">Pexels</a></p>
