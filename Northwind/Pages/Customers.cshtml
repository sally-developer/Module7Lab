@page
@model CustomersModel

@{
    ViewData["Title"] = "Our customers";
}

<section class="customers-hero">
    <div>
        <span class="eyebrow"><span aria-hidden="true">♡</span> Our favorite people</span>
        <h1>Meet the <span>neighbors.</span></h1>
        <p>Every name here is part of our Northwind story. Take a peek around.</p>
        <div class="customer-count"><span class="count-flower" aria-hidden="true">✿</span><strong>@Model.Customers.Count</strong> lovely customers</div>
    </div>
    <div class="customers-hero-photo">
        <img src="https://images.pexels.com/photos/3184436/pexels-photo-3184436.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1000"
             alt="A group of people joining hands around a table" />
        <span class="customers-photo-note">There's always<br />room for one more!</span>
    </div>
</section>

<section class="directory-section" aria-labelledby="directory-title">
    <div class="directory-heading">
        <div>
            <span class="section-kicker">The little directory</span>
            <h2 id="directory-title">A few familiar faces</h2>
        </div>
        <span class="directory-caption">Sorted with love <span aria-hidden="true">✿</span></span>
    </div>

    <div class="directory-table-wrap">
        <table class="directory-table">
            <thead>
                <tr>
                    <th scope="col">Customer</th>
                    <th scope="col">Company</th>
                    <th scope="col">Contact person</th>
                    <th scope="col">From</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td><span class="customer-avatar" aria-hidden="true">@customer.CompanyName.Substring(0, 1)</span><span class="customer-id">@customer.CustomerID</span></td>
                        <td class="company-name">@customer.CompanyName</td>
                        <td>@customer.ContactName</td>
                        <td><span class="country-tag">@customer.Country</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="photo-credit">A little color for the page, photography via <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer">Pexels</a></p>
</section>
